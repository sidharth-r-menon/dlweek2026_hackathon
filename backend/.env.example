# ─────────────────────────────────────────────────────────────
# Cross-Lingual Community Safety Radio — Environment Variables
# Copy this file to .env and fill in your Azure credentials
# ─────────────────────────────────────────────────────────────

# ── Azure OpenAI (LLM) ──────────────────────────────────────
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# ── Azure OpenAI gpt-4o-transcribe (Speech-to-Text) ──────────
# Same Azure OpenAI resource can be used as the LLM above.
# Deploy gpt-4o-transcribe model and set the deployment name below.
AZURE_WHISPER_API_KEY=your-azure-openai-api-key
AZURE_WHISPER_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_WHISPER_API_VERSION=2025-01-01-preview
AZURE_WHISPER_DEPLOYMENT_NAME=gpt-4o-transcribe

# ── Data.gov.sg ─────────────────────────────────────────────
DATAGOVSG_API_URL=https://data.gov.sg/api/action/datastore_search

# ── OSM Nominatim ───────────────────────────────────────────
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ── Open-Meteo (NOAA-sourced weather) ────────────────────────
OPENMETEO_API_URL=https://api.open-meteo.com/v1/forecast

# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
