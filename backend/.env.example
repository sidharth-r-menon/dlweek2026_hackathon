# ─────────────────────────────────────────────────────────────
# Cross-Lingual Community Safety Radio — Environment Variables
# Copy this file to .env and fill in your Azure credentials
#
# Run `python check_azure.py` after filling in values to verify
# all services are reachable before starting the backend.
# ─────────────────────────────────────────────────────────────

# ── Azure OpenAI (LLM / chat completions) ───────────────────
# Standard Azure OpenAI resource endpoint:
#   https://<resource-name>.openai.azure.com/
# Azure AI Foundry project endpoint (also supported):
#   https://<resource-name>.services.ai.azure.com/api/projects/<project>
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# ── Azure OpenAI Realtime (gpt-realtime WebSocket) ───────────
# Used for: live transcription via /ws/transcribe/{session_id}
#
# ⚠ ENDPOINT FORMAT: Must be the BASE DOMAIN ONLY — no path, no query string.
#   CORRECT:   https://your-resource.cognitiveservices.azure.com/
#   WRONG:     https://your-resource.cognitiveservices.azure.com/openai/realtime?...
#
# The backend builds the full WebSocket URL internally:
#   wss://<ENDPOINT>/openai/realtime?deployment=<NAME>&api-version=<VERSION>
#
# Deploy the 'gpt-4o-realtime-preview' model in Azure AI Foundry and set
# the deployment name below (commonly named 'gpt-realtime' or similar).
AZURE_WHISPER_API_KEY=your-azure-openai-api-key
AZURE_WHISPER_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_WHISPER_API_VERSION=2024-10-01-preview
AZURE_WHISPER_DEPLOYMENT_NAME=gpt-realtime
AZURE_REALTIME_API_VERSION=2024-10-01-preview

# ── Data.gov.sg ─────────────────────────────────────────────
DATAGOVSG_API_URL=https://data.gov.sg/api/action/datastore_search

# ── OSM Nominatim ───────────────────────────────────────────
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ── Open-Meteo (NOAA-sourced weather) ────────────────────────
OPENMETEO_API_URL=https://api.open-meteo.com/v1/forecast

# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
